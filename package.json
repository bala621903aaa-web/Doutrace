{
  "name": "douyin-chat-archive",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "package": "npm run build && node scripts/package.mjs",
    "desktop:check": "npm --prefix desktop run check",
    "desktop:test": "npm --prefix desktop run test",
    "desktop:probe": "npm --prefix desktop run probe",
    "desktop:verify-history": "npm --prefix desktop run verify:history",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build:dev": "npm --prefix desktop run build:dev",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:package": "npm --prefix desktop run package"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
